  "components": {
    "parameters": {
      "OcpApimSubscriptionKey": {
        "name": "Ocp-Apim-Subscription-Key",
        "in": "header",
        "description": "**Subscription key provided by Looplex**",
        "example": "{{Ocp-Apim-Subscription-Key}}",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Tenant": {
        "name": "x-looplex-tenant",
        "in": "header",
        "description": "**Client domain**",
        "example": "{{client_domain}}",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "BearerToken": {
        "name": "Authorization",
        "in": "header",
        "description": "**The authorization token**<br/>\n_Bearer \\<token_from_authentication_endpoint_response\\>_\n",
        "required": true,
        "example": "Bearer {{token}}",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "MetaQuery": {
        "title": "Meta",
        "type": "object",
        "description": "**Resource's metadata**",
        "properties": {
          "ResourceType": {
            "type": "string",
            "description": "**The resource type**<br />\ne.g. Case, Task, Entry, etc.\n",
            "example": "<tipo_do_recurso>"
          },
          "Created": {
            "type": [
              "string",
              "null"
            ],
            "format": "datetime",
            "example": "<data_de_criacao_do_recurso>",
            "description": "**The resource creation date**"
          },
          "LastModified": {
            "type": [
              "string",
              "null"
            ],
            "format": "datetime",
            "example": "<data_de_atualizacao_do_recurso>",
            "description": "**The resource last update time**"
          },
          "Location": {
            "type": [
              "string",
              "null"
            ],
