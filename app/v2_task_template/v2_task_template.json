        "name": "id",
        "in": "path",
        "required": true,
        "description": "**The item's unique identifier**",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "StartIndex": {
        "name": "startIndex",
        "in": "query",
        "required": true,
        "description": "**Index of search**",
        "example": 1,
        "schema": {
          "type": "integer"
        }
      },
      "Count": {
        "name": "count",
        "in": "query",
        "required": true,
        "description": "**Total count of items to return**<br />\n`Max of 120`\n",
        "example": 50,
        "schema": {
          "type": "integer"
        }
      },
      "Filter": {
        "name": "filter",
        "in": "query",
        "required": false,
        "description": "**SCIM filter to search**<br />\n**e.g:**<br />\n_Description_ _co_ _search_term_\n",
        "schema": {
          "type": "string"
        },
        "example": null
