                "type": "string",
                "description": "replace  \n**Substitui o valor da propriedade por outro**\n"
              }
            ]
          },
          "value": {
            "description": "**The new value to set**",
            "example": "<value>",
            "oneOf": [
              {
                "type": "string",
                "description": "**A string value**\n"
              },
              {
                "type": "number",
                "description": "**A number value**\n"
              },
              {
                "type": "object",
                "description": "**A simple object containing one or more properties, depending on Resource property beeing patched**<br />\n```json\n  // Example:\n  {\n    \"<property_name>\": \"<property_value>\",\n    ...other properties if needed\n  }\n  ```\n"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "**An object containing one or more properties, depending on Resource property beeing patched**<br/>\n```json\n// Example:\n[\n  {\n    \"<property_name>\": \"<property_value>\",\n    ...other properties if needed\n  }\n]\n```\n"
