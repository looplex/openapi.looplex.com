        "description": "**Client domain**",
        "example": "{{client_domain}}",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "BearerToken": {
        "name": "Authorization",
        "in": "header",
        "description": "**The authorization token**<br/>\n_Bearer \\<token_from_authentication_endpoint_response\\>_\n",
        "required": true,
        "example": "Bearer {{token}}",
        "schema": {
          "type": "string"
        }
      },
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "**The item's unique identifier**",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "StartIndex": {
        "name": "startIndex",
        "in": "query",
        "required": true,
        "description": "**Index of search**<br/>`Default: 1`",
        "example": 1,
        "schema": {
          "type": "integer"
        }
      },
      "Count": {
        "name": "count",
        "in": "query",
        "required": true,
        "description": "**Total count of items to return**<br />\n`Default: 1` | `Max of 120`\n",
        "example": 12,
        "schema": {
          "type": "integer"
        }
      },
      "Filter": {
        "name": "filter",
        "in": "query",
        "required": false,
        "description": "**SCIM filter to search**<br />\n**e.g:**<br />\n_Description_ _co_ _search_term_\n",
        "schema": {
          "type": "string"
        },
        "example": null
      }
