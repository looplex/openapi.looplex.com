  "security": [],
  "paths": {
    "/hierarchy": {
      "get": {
        "tags": [
          "Court Venue"
        ],
        "summary": "Query court venue by filter",
        "description": "**Query court venue by filter**\n",
        "operationId": "hierarchy-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/BearerToken"
          },
          {
            "name": "Filter",
            "in": "query",
            "required": false,
            "example": "label=Estadual and cnj=8.02 and level=1 and path=/2/ and tags=00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000 and depth=2 and uuids=00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000\n",
            "description": "**The filter to search**<br /><br />\n**NOTE: Concatenate every parameter with 'and'**<br />\n**Valid options:**<br />\n- **label (string)**: the node name to search<br />\n- **cnj (string)**: cnj number to search<br />\n- **level (integer)**: filter items by level <br />\n- **path (string)**: the path to search <br />\n- **tags (string)**: tags' unique ids separated by comma <br />\n- **depth (integer)**: depth of descendant levels to include in the results <br />\n- **uuids (string)**: node's unique ids separated by comma <br /> \n- **ids (string)**: node's ids separated by comma\n",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ListResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "resources": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Hierarchy"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/subjectTags": {
      "get": {
        "tags": [
          "Court Venue"
        ],
        "summary": "Get all tag groups",
        "description": "**Get all tag groups**\n",
        "operationId": "subjectTags-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/BearerToken"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TagGroup"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/tags": {
      "get": {
        "tags": [
          "Court Venue"
        ],
        "summary": "List tags by tag group",
        "description": "**List tags by tag group**\n",
        "operationId": "subjectTags-uuid-tags-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/BearerToken"
          },
          {
            "name": "Filter",
            "in": "query",
            "required": true,
            "description": "**Unique identifier of tag's group**",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ListResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "resources": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Tag"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "api_key"
      },
      "auth_token": {
        "type": "apiKey",
        "in": "header",
        "name": "auth_token"
      },
      "basic_auth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "parameters": {
      "OcpApimSubscriptionKey": {
        "name": "Ocp-Apim-Subscription-Key",
        "in": "header",
        "description": "**Subscription key provided by Looplex**",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "BearerToken": {
        "name": "Authorization",
        "in": "header",
        "description": "**The authorization token**<br />\n**Example:**<br />`Bearer <token_from_authentication_endpoint_response>`\n",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ListResponse": {
        "title": "ListResponse",
        "type": "object",
        "properties": {
          "totalResults": {
            "description": "**Total count of items in the filter**",
            "type": "integer",
            "example": 100
          },
          "startIndex": {
            "description": "**Index of search**",
            "type": "integer",
            "example": 1
          },
          "itemsPerPage": {
            "description": "**Total count of items to return**",
            "type": "integer",
            "example": 12
          }
        }
      },
      "Meta": {
        "title": "Meta",
        "type": "object",
        "properties": {
          "ResourceType": {
            "type": "string",
            "description": "**The resource type**<br />\ne.g. Case, Task, Entry, etc.\n",
            "example": "Entity"
          },
          "Created": {
            "type": "string <nullable>",
            "format": "datetime",
            "example": null,
            "description": "**The resource creation date**"
          },
          "LastModified": {
            "type": "string <nullable>",
            "format": "datetime",
            "example": null,
            "description": "**The resource last update time**"
          },
          "Location": {
            "type": "string <nullable>",
            "example": "https://apim.looplex.com/<service_name>/<version_number>/<entity>/<item_unique_id>",
            "description": "**The resource url**"
          },
          "Version": {
            "type": "string",
            "example": "2.0",
            "description": "**The resource version**"
          }
        }
      },
      "Hierarchy": {
        "title": "Hierarchy",
        "type": "object",
        "properties": {
          "Id": {
            "description": "**Item's identifier**",
            "type": "integer"
          },
          "UUID": {
            "description": "**Item's unique identifier**",
            "type": "string",
            "format": "uuid"
          },
          "Level": {
            "type": "integer",
            "description": "**Item's level**"
          },
          "Label": {
            "type": "string",
            "description": "**Item's name**"
          },
          "Active": {
            "type": "boolean",
            "description": "**Indicate if the item is active**"
          },
          "Status": {
            "type": "integer",
            "description": "**Item's status**"
          },
          "JTROOOO": {
            "type": "string",
            "description": "**CNJ**"
          },
          "Path": {
            "type": "string",
            "description": "**Item's path in tree**"
          },
          "Serventia": {
            "type": "integer <nullable>",
            "description": ""
          },
          "SmallClaimsCourt": {
            "type": "boolean <nulable>",
            "description": ""
          },
          "AdjucatingCourt": {
            "type": "boolean <nullable>",
            "description": ""
          },
          "Ordering": {
            "type": "integer <nullable>",
            "description": ""
          },
          "ExternalId": {
            "description": "**Item's external identifier**",
            "type": "string"
          },
          "Meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "TagGroup": {
        "title": "TagGroup",
        "type": "object",
        "properties": {
          "uuid": {
            "description": "**Unique identifier of tag's group**",
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "description": "**The name of tag's group**"
          },
          "active": {
            "type": "boolean",
            "description": "**Indicate if it is active**"
          },
          "Meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "Tag": {
        "title": "Tag",
        "type": "object",
        "properties": {
          "Id": {
            "description": "**Item's identifier**",
            "type": "integer"
          },
          "UUID": {
            "description": "**Tag's unique identifier**",
            "type": "string",
            "format": "uuid"
          },
          "Label": {
            "type": "string",
            "description": "**Tag's name**"
          },
          "Active": {
            "type": "boolean",
            "description": "**Indicate if it is active**"
          },
          "Status": {
            "type": "integer",
            "description": "**Tag's status**"
          },
          "ExternalId": {
            "description": "**Item's external identifier**",
            "type": "string"
          },
          "Meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      }
    }
  }
}