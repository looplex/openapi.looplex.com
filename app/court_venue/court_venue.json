{
  "openapi": "3.0.2",
  "info": {
    "version": "2.0.0",
    "title": "Looplex Court Venue",
    "termsOfService": "https://docs.looplex.com.br/legal/termos-de-uso",
    "contact": {
      "name": "Developers Looplex",
      "email": "developer@looplex.com.br",
      "url": "https://www.looplex.com.br"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-logo": {
      "url": "https://www.looplex.com.br/img/logo-default.png",
      "href": "/"
    },
    "description": "Essa é a documentação de Court Venue\n"
  },
  "servers": [
    {
      "url": "https://apim.looplex.com/courtVenue",
      "description": "Court Venue Server"
    }
  ],
  "security": [],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Court Venue"
        ],
        "summary": "Query court venue by filters",
        "description": "**Query court venue by filters**\n",
        "operationId": "-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/BearerToken"
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "example": "\"Estadual\"",
            "description": "**the node name to search**",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cnj",
            "in": "query",
            "required": false,
            "example": "\"8.02\"",
            "description": "**cnj number to search**",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "example": 1,
            "description": "**filter items by level**",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "example": "\"/2/\"",
            "description": "**the path to search**",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "example": "00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000",
            "description": "**tags' unique ids separated by comma**",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "example": 2,
            "description": "**depth of descendant levels to include in the results.**",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "uuids",
            "in": "query",
            "required": false,
            "example": "00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000",
            "description": "**node's unique ids separated by comma**",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "example": "−2147483648,−2147483648",
            "description": "**node's ids separated by comma**",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Hierarchy"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/subjectTags": {
      "get": {
        "tags": [
          "Court Venue"
        ],
        "summary": "Get all tag groups",
        "description": "**Get all tag groups**\n",
        "operationId": "subjectTags-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/BearerToken"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TagGroup"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/subjectTags/:uuid/tags": {
      "get": {
        "tags": [
          "Court Venue"
        ],
        "summary": "List tags by tag group",
        "description": "**List tags by tag group**\n",
        "operationId": "subjectTags-uuid-tags-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/BearerToken"
          },
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "description": "**Unique identifier of tag's group**",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tag"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "api_key"
      },
      "auth_token": {
        "type": "apiKey",
        "in": "header",
        "name": "auth_token"
      },
      "basic_auth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "parameters": {
      "OcpApimSubscriptionKey": {
        "name": "Ocp-Apim-Subscription-Key",
        "in": "header",
        "description": "**Subscription key provided by Looplex**",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "BearerToken": {
        "name": "Authorization",
        "in": "header",
        "description": "**The authorization token**<br />\n**Example:**<br />`Bearer <token_from_authentication_endpoint_response>`\n",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Hierarchy": {
        "title": "Hierarchy",
        "type": "object",
        "properties": {
          "id": {
            "description": "**Item's identifier**",
            "type": "integer"
          },
          "uuid": {
            "description": "**Item's unique identifier**",
            "type": "string",
            "format": "uuid"
          },
          "level": {
            "type": "integer",
            "description": "**Item's level**"
          },
          "label": {
            "type": "string",
            "description": "**Item's name**"
          },
          "active": {
            "type": "boolean",
            "description": "**Indicate if the item is active**"
          },
          "jtroooo": {
            "type": "string",
            "description": "**CNJ**"
          },
          "path": {
            "type": "string",
            "description": "**Item's path in tree**"
          },
          "serventia": {
            "type": "integer <nullable>",
            "description": ""
          },
          "smallClaimsCourt": {
            "type": "boolean <nulable>",
            "description": ""
          },
          "adjucatingCourt": {
            "type": "boolean <nullable>",
            "description": ""
          },
          "ordering": {
            "type": "integer <nullable>",
            "description": ""
          }
        }
      },
      "TagGroup": {
        "title": "TagGroup",
        "type": "object",
        "properties": {
          "uuid": {
            "description": "**Unique identifier of tag's group**",
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "description": "**The name of tag's group**"
          },
          "active": {
            "type": "boolean",
            "description": "**Indicate if it is active**"
          }
        }
      },
      "Tag": {
        "title": "Tag",
        "type": "object",
        "properties": {
          "uuid": {
            "description": "**Tag's unique identifier**",
            "type": "string",
            "format": "uuid"
          },
          "tag": {
            "type": "string",
            "description": "**Tag's name**"
          },
          "active": {
            "type": "boolean",
            "description": "**Indicate if it is active**"
          }
        }
      }
    }
  }
}