{
  "openapi": "3.0.2",
  "info": {
    "version": "2.0.0",
    "title": "Looplex Court Venue",
    "termsOfService": "https://docs.looplex.com.br/legal/termos-de-uso",
    "contact": {
      "name": "Developers Looplex",
      "email": "developer@looplex.com.br",
      "url": "https://www.looplex.com.br"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-logo": {
      "url": "https://www.looplex.com.br/img/logo-default.png",
      "href": "/"
    },
    "description": "Essa é a documentação de Court Venue\n"
  },
  "servers": [
    {
      "url": "https://apim.looplex.com/courtVenue",
      "description": "Court Venue Server"
    }
  ],
  "security": [],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Court Venue"
        ],
        "summary": "Get first level items",
        "description": "**Get first level items**\n",
        "operationId": "-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/BearerToken"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Hierarchy"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "api_key"
      },
      "auth_token": {
        "type": "apiKey",
        "in": "header",
        "name": "auth_token"
      },
      "basic_auth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "parameters": {
      "OcpApimSubscriptionKey": {
        "name": "Ocp-Apim-Subscription-Key",
        "in": "header",
        "description": "**Subscription key provided by Looplex**",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "BearerToken": {
        "name": "Authorization",
        "in": "header",
        "description": "**The authorization token**<br />\n**Example:**<br />`Bearer <token_from_authentication_endpoint_response>`\n",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Hierarchy": {
        "title": "Hierarchy",
        "type": "object",
        "properties": {
          "uuid": {
            "description": "Item's unique identifier",
            "type": "string",
            "format": "uuid"
          },
          "level": {
            "type": "integer",
            "description": "Item's level"
          },
          "label": {
            "type": "string",
            "description": "Item's name"
          },
          "active": {
            "type": "boolean",
            "description": "Indicate if the item is active"
          },
          "jtroooo": {
            "type": "string",
            "description": "CNJ"
          },
          "path": {
            "type": "string",
            "description": "Item's path in tree"
          },
          "serventia": {
            "type": "integer <nullable>",
            "description": ""
          },
          "smallClaimsCourt": {
            "type": "boolean <nulable>",
            "description": ""
          },
          "adjucatingCourt": {
            "type": "boolean <nullable>",
            "description": ""
          },
          "ordering": {
            "type": "integer <nullable>",
            "description": ""
          }
        }
      }
    }
  }
}