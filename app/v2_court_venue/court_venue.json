                        },
                        {
                          "properties": {
                            "Resources": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Foro_v2_1"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
