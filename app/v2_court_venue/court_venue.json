                        {
                          "properties": {
                            "conteudo": {
                              "type": "object",
                              "properties": {
                                "hierarquiaCompleta": {
                                  "type": "string",
                                  "description": "A hierarquia completa do item"
                                },
                                "hierarquiaFormatada": {
                                  "type": "string",
                                  "description": "A hierarquia formatada do item"
                                }
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "allOf": [
                        {
                          "properties": {
                            "hierarquiaCompleta": {
                              "type": "string",
                              "description": "A hierarquia completa do item"
                            },
                            "hierarquiaFormatada": {
                              "type": "string",
                              "description": "A hierarquia formatada do item"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
