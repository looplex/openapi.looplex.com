  "paths": {
    "/v2.1/court/:id/nextLevels": {
      "get": {
        "tags": [
          "Court Venue"
        ],
        "summary": "Next levels",
        "description": "List next levels after this node level",
        "operationId": "v2.1-court-id-nextLevels-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "**The item's identifier**",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "quantityLevels",
            "in": "query",
            "required": false,
            "description": "**The level quantity to search** `(default: 2)`",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/ResponseFormat"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/ListResponseLegacy"
                        },
                        {
                          "properties": {
                            "conteudo": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Foro_v2_1"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/ListResponse"
                        },
                        {
                          "properties": {
                            "Resources": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Foro_v2_1"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
