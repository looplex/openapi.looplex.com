  "paths": {
    "/v2.1/ProximosNiveis/:id": {
      "get": {
        "tags": [
          "Varas e Foros"
        ],
        "summary": "Lista os próximos níveis",
        "operationId": "varas_foros-proximos_niveis-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "**The item's unique identifier**",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "quantidadeNiveis",
            "in": "query",
            "required": false,
            "description": "**A quantidade de níveis a pesquisar** `(default: 2)`",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/ResponseFormat"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/ListResponseLegacy"
                        },
                        {
                          "properties": {
                            "conteudo": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Foro"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/ListResponse"
                        },
                        {
                          "properties": {
                            "Resources": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Foro"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
