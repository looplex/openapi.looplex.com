    "/v2.1/procedures": {
      "get": {
        "tags": [
          "Procedure"
        ],
        "summary": "List procedures by filters",
        "description": "**List procedures by filters**",
        "operationId": "v2.1-procedures-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/ResponseFormat"
          },
          {
            "name": "nodeUuid",
            "in": "query",
            "required": false,
            "description": "**The node unique identifier to list the procedures**",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "nodeId",
            "in": "query",
            "required": false,
            "description": "**The node identifier to list the procedures**",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "procedureId",
            "in": "query",
            "required": false,
            "description": "**The procedure identifier**",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "procedureName",
            "in": "query",
            "required": false,
            "description": "**The procedure name to search**",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/ListResponseLegacy"
                        },
                        {
                          "properties": {
                            "conteudo": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "group": {
                                    "type": "string",
                                    "description": "**The group name**"
                                  },
                                  "groupId": {
                                    "type": "integer",
                                    "description": "**The group id**"
                                  },
                                  "children": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "subGroup": {
                                          "type": "string",
                                          "description": "**The subGroup name**"
                                        },
                                        "children": {
                                          "type": "array",
                                          "items": {
                                            "$ref": "#/components/schemas/Procedure_v2_1"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/ListResponse"
                        },
                        {
                          "properties": {
                            "Resources": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "group": {
                                    "type": "string",
                                    "description": "**The group name**"
                                  },
                                  "groupId": {
                                    "type": "integer",
                                    "description": "**The group id**"
                                  },
                                  "children": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "subGroup": {
                                          "type": "string",
                                          "description": "**The subGroup name**"
                                        },
                                        "children": {
                                          "type": "array",
                                          "items": {
                                            "$ref": "#/components/schemas/Procedure_v2_1"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SCIMError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "api_key"
      },
      "auth_token": {
        "type": "apiKey",
        "in": "header",
        "name": "auth_token"
      },
      "basic_auth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "parameters": {
      "OcpApimSubscriptionKey": {
        "name": "Ocp-Apim-Subscription-Key",
        "in": "header",
        "description": "**Subscription key provided by Looplex**",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ResponseFormat": {
        "name": "responseFormat",
        "in": "query",
        "required": false,
        "description": "**The response format**<br/>\n0: legacy `(default)`<br/>\n1: scim\n\n**Formato da resposta do endpoint**<br/>\n**Legacy** -> _retornado quando responseFormat for 0_<br/>\n**Scim** -> _retornado quando responseFormat for 1 e a resposta for uma lista_\n**object** -> _retornado quando responseFormat for 1 e a resposta for um objeto_\n",
        "schema": {
          "type": "integer"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "**The page to search**. `(default: 1)`",
        "schema": {
          "type": "integer"
        }
      },
      "PerPage": {
        "name": "perPage",
        "in": "query",
        "required": false,
        "description": "**The quantity of items for the page**. `(default: 10)`",
        "schema": {
          "type": "integer"
        }
      }
    },
    "schemas": {
      "TipoRespostaRequisicao": {
        "title": "TipoRespostaRequisicao",
        "type": "integer",
        "example": 3,
        "description": "1: Exception<br/>\n2: SemDados<br/>\n3: ComDados<br/>\n"
      },
      "ListResponseLegacy": {
        "title": "Legacy",
        "type": "object",
        "properties": {
          "respostaAPI": {
            "type": "string"
          },
          "tipoResposta": {
            "$ref": "#/components/schemas/TipoRespostaRequisicao"
          }
        }
      },
      "Foro_v2_1": {
        "title": "Foro",
        "description": "Dados de um foro / vara",
        "properties": {
          "cdNo": {
            "type": "integer",
            "example": 1,
            "description": "identificador do foro / vara"
          },
          "cdNoPai": {
            "type": "integer",
            "example": 1,
            "description": "identificador do foro pai"
          },
          "dsCategoriaFilhos": {
            "type": "string",
            "example": "string de exemplo",
            "description": "Indicação da categoria de filhos desse item"
          },
          "dsHierarquiaCompleta": {
            "type": "string",
            "example": "string de exemplo",
            "description": "Hierarquia completa até esse item"
          },
          "dsNome": {
            "type": "string",
            "example": "string de exemplo",
            "description": "Nome do item"
          },
          "inAtivo": {
            "type": "integer",
            "example": 1,
            "description": "Indica se o item está ativo"
          },
          "labelProximosNiveis": {
            "type": "string",
            "example": "string de exemplo",
            "description": "Label dos próximos itens"
          },
          "nrNivel": {
            "type": "integer",
            "example": 1,
            "description": "O nível ao qual esse item pertence"
          },
          "uuid": {
            "type": "string",
            "format": "uuid",
            "description": "**Item's unique identifier**"
          },
          "custom_fields": {
            "type": "object",
            "description": "**Custom fields for this item**"
          },
          "filhos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Foro_v2_1"
            }
          }
        }
      },
      "ListResponse": {
        "title": "Scim",
        "type": "object",
        "properties": {
          "totalResults": {
            "description": "**Total count of items in the filter**",
            "type": "integer",
            "example": 100
          },
          "startIndex": {
            "description": "**Index of search**",
            "type": "integer",
            "example": 1
          },
          "itemsPerPage": {
            "description": "**Total count of items to return**",
            "type": "integer",
            "example": 12
          }
        }
      },
      "Procedure_v2_1": {
        "title": "Procedure",
        "type": "object",
        "properties": {
          "procedureId": {
            "type": "integer",
            "description": "**The identifier of this procedure**"
          },
          "procedureUuid": {
            "type": "string",
            "format": "uuid",
            "description": "**The unique identifier of this procedure**"
          },
          "procedureName": {
            "type": "string",
            "description": "**The procedure name**"
          },
          "cnjCode": {
            "type": "string",
            "description": "**The CNJ code of this procedure**"
          },
          "customFields": {
            "type": "object",
            "description": "**Custom fields for this procedure**"
          }
        }
      },
      "SCIMtypeError": {
        "title": "SCIM Type error",
        "type": "string",
        "description": "**SCIM type error**<br/>\ninvalidFilter<br/>\ntooMany<br/>\nuniqueness<br/>\nmutability<br/>\ninvalidSyntax<br/>\ninvalidPath<br/>\nnoTarget<br/>\ninvalidValue<br/>\ninvalidVers<br/>\nsensitive\n"
      },
      "SCIMError": {
        "title": "SCIM Error",
        "type": "object",
        "properties": {
          "scimType": {
            "description": "**The SCIM type if request is GET, otherwise null**",
            "example": "invalidFilter",
            "oneOf": [
              {
                "type": null,
                "description": "**It is not a SCIM error**"
              },
              {
                "$ref": "#/components/schemas/SCIMtypeError",
                "description": "**The type of SCIM error**"
              }
            ]
          },
          "detail": {
            "type": "string",
            "description": "**The error message**",
            "example": "The filter is invalid"
          },
          "status": {
            "type": "string",
            "description": "**The HTTP Status Code error name**",
            "example": "InternalServerError"
          }
        }
      }
    }
  }
}