  "security": [],
  "paths": {
    "/v2.1/court/:id/nextLevels": {
      "get": {
        "tags": [
          "Court Venue"
        ],
        "summary": "Next levels",
        "description": "List next levels after this node level",
        "operationId": "court-id-nextLevels-get.yaml",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "**The item's identifier**",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "quantityLevels",
            "in": "query",
            "required": false,
            "description": "**The level quantity to search** `(default: 2)`",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/ResponseFormat"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/ListResponseLegacy"
                        },
                        {
                          "properties": {
                            "conteudo": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Foro"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/ListResponse"
                        },
                        {
                          "properties": {
                            "Resources": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Foro"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v2.1/court/:id/formattedHierarchy": {
      "get": {
        "tags": [
          "Court Venue"
        ],
        "summary": "Formatted hierarchy",
        "description": "Get the formatted hierarchy from this node",
