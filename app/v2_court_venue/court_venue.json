        ],
        "summary": "Lista os itens filhos desse item",
        "operationId": "varas_foros-court-children",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "**The item's unique identifier**",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "**The page to search**. `(default: 1)`",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "required": false,
            "description": "**The page to search**. `(default: 10)`",
            "schema": {
