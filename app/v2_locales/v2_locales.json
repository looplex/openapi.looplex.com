  "paths": {
    "/Countries": {
      "get": {
        "tags": [
          "Countries"
        ],
        "summary": "/Countries",
        "description": "**Fetch items paginated**",
        "operationId": "Countries-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/StartIndex"
          },
          {
            "$ref": "#/components/parameters/Count"
          },
          {
            "$ref": "#/components/parameters/Filter"
          },
          {
            "name": "CountryId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ListResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "resources": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/CountryEntityQuery"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SCIMError"
                }
              }
            }
          }
        }
      }
    },
    "/Regions/:id": {
      "get": {
        "tags": [
          "Regions"
        ],
        "summary": "Regions",
        "description": "**Fetch items paginated**",
        "operationId": "Regions-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/StartIndex"
          },
          {
            "$ref": "#/components/parameters/Count"
          },
          {
            "$ref": "#/components/parameters/Filter"
          },
          {
            "name": "CountryId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ListResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "resources": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/RegionEntityQuery"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SCIMError"
                }
              }
            }
          }
        }
      }
    },
    "/Localities/:id": {
      "get": {
        "tags": [
          "Localities"
        ],
        "summary": "/Localities",
        "description": "**Fetch items paginated**",
        "operationId": "Localities-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/StartIndex"
          },
          {
            "$ref": "#/components/parameters/Count"
          },
          {
            "$ref": "#/components/parameters/Filter"
          },
          {
            "name": "RegionId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ListResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "resources": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/LocalityEntityQuery"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SCIMError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "OcpApimSubscriptionKey": {
        "name": "Ocp-Apim-Subscription-Key",
        "in": "header",
        "description": "**Subscription key provided by Looplex**",
        "example": "{{Ocp-Apim-Subscription-Key}}",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "StartIndex": {
        "name": "startIndex",
        "in": "query",
        "required": true,
        "description": "**Index of search**",
        "example": 1,
        "schema": {
          "type": "integer"
        }
      },
      "Count": {
        "name": "count",
        "in": "query",
        "required": true,
        "description": "**Total count of items to return**<br />\n`Max of 120`\n",
        "example": 50,
        "schema": {
          "type": "integer"
        }
      },
      "Filter": {
        "name": "filter",
        "in": "query",
        "required": false,
        "description": "**SCIM filter to search**<br />\n**e.g:**<br />\n_Description_ _co_ _search_term_\n",
        "schema": {
          "type": "string"
        },
        "example": null
      }
    },
    "schemas": {
      "ListResponse": {
        "title": "Scim",
        "type": "object",
        "properties": {
          "totalResults": {
            "description": "**Total count of items in the filter**",
            "type": "integer",
            "example": 100
          },
          "startIndex": {
            "description": "**Index of search**",
            "type": "integer",
            "example": 1
          },
          "itemsPerPage": {
            "description": "**Total count of items to return**",
            "type": "integer",
            "example": 12
          }
        }
      },
      "MetaQuery": {
        "title": "Meta",
        "type": "object",
        "description": "**Resource's metadata**",
        "properties": {
          "ResourceType": {
            "type": "string",
            "description": "**The resource type**<br />\ne.g. Case, Task, Entry, etc.\n",
            "example": "<tipo_do_recurso>"
          },
          "Created": {
            "type": "string <nullable>",
            "format": "datetime",
            "example": "<data_de_criacao_do_recurso>",
            "description": "**The resource creation date**"
          },
          "LastModified": {
            "type": "string <nullable>",
            "format": "datetime",
            "example": "<data_de_atualizacao_do_recurso>",
            "description": "**The resource last update time**"
          },
          "Location": {
            "type": "string <nullable>",
            "example": "<local_do_recurso>",
            "description": "**The resource url**"
          },
          "Version": {
            "type": "string",
            "example": "<versao_do_recurso>",
            "description": "**The resource version**"
          }
        }
      },
      "ResourceQuery": {
        "title": "Resource",
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid",
            "description": "**Object unique identifier**",
            "example": "<global_unique_identifier>"
          },
          "ExternalId": {
            "example": "<external_id>",
            "type": "string <nullable>",
            "description": "**External identifier**"
          },
          "Meta": {
            "description": "**Informações relacionadas à essa entity**",
            "$ref": "#/components/schemas/MetaQuery"
          }
        }
      },
      "CountryEntityQuery": {
        "title": "CountryEntity",
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/ResourceQuery"
          },
          {
            "type": "object",
            "properties": {
              "EnglishName": {
                "type": "string"
              },
              "FrenchName": {
                "type": "string"
              },
              "PortugueseName": {
                "type": "string"
              },
              "SpanishName": {
                "type": "string"
              },
              "GermanName": {
                "type": "string"
              },
              "Alpha2Code": {
                "type": "string"
              },
              "Alpha3Code": {
                "type": "string"
              },
              "NumericCode": {
                "type": "integer"
              },
              "EnglishDemonym": {
                "type": "string"
              },
              "FrenchDemonym": {
                "type": "string"
              },
              "PortugueseDemonym": {
                "type": "string"
              },
              "SpanishDemonym": {
                "type": "string"
              },
              "GermanDemonym": {
                "type": "string"
              },
              "CustomFields": {
                "type": "object"
              }
            }
          }
        ]
      },
      "SCIMtypeError": {
        "title": "SCIM Type error",
        "type": "string <nullable>",
        "example": "invalidFilter",
        "description": "**The type of SCIM error if request is GET, otherwise null**<br/>\ninvalidFilter<br/>\ntooMany<br/>\nuniqueness<br/>\nmutability<br/>\ninvalidSyntax<br/>\ninvalidPath<br/>\nnoTarget<br/>\ninvalidValue<br/>\ninvalidVers<br/>\nsensitive\n"
      },
      "SCIMError": {
        "title": "SCIM Error",
        "type": "object",
        "properties": {
          "scimType": {
            "$ref": "#/components/schemas/SCIMtypeError"
          },
          "detail": {
            "type": "string",
            "description": "**The error message**",
            "example": "<exception_message>"
          },
          "status": {
            "type": "string",
            "description": "**The HTTP Status Code error name**",
            "example": "InternalServerError"
          }
        }
      },
      "RegionEntityQuery": {
        "title": "RegionEntity",
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/ResourceQuery"
          },
          {
            "type": "object",
            "properties": {
              "Name": {
                "type": "string"
              },
              "Acronym": {
                "type": "string"
              },
              "ISOCode": {
                "type": "string"
              },
              "CustomFields": {
                "type": "object"
              }
            }
          }
        ]
      },
      "LocalityEntityQuery": {
        "title": "LocalityEntity",
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/ResourceQuery"
          },
          {
            "type": "object",
            "properties": {
              "Name": {
                "type": "string"
              },
              "Code": {
                "type": "integer"
              },
              "FullCode": {
                "type": "integer"
              },
              "CustomFields": {
                "type": "object"
              }
            }
          }
        ]
      }
    }
  }
}