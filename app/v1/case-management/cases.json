      "CaseHierarchy": {
        "title": "CaseHierarchy",
        "description": "Hierarquia do caso, mostra todos os casos relacionados a este, seus antecessores e sucessores",
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid",
            "description": "**Case unique identifier**"
          },
          "Status": {
            "type": "string",
            "example": "Ativo",
            "description": "**Indicação do status do caso**<br />\nAtivo<br />\nInativo<br />\nArquivado<br />\nExcluído\n"
          },
          "Type": {
            "type": "string",
            "example": "Judicial Estadual",
            "description": "**Indicação do tipo de caso, define o tipo de justiça ou o tipo de transação jurídica**<br />\nJudicial Estadual<br />\nJudicial Federal<br />\nJudicial Trabalhista<br />\nMilitar Estadual<br />\nMilitar União<br />\nEleitoral<br />\nConsultivo<br />\nContrato<br />\nSocietário<br />\nCobrança Extrajudicial<br />\nDue Diligence e Análise Documental<br />\nAdministrativo<br />\nArbitragem\n"
          },
          "SubType": {
            "type": "string",
            "example": "Caso",
            "description": "**Indicação do subtipo de caso, define se ele é um caso originário ou uma continuação como um recurso, incidente ou um subcaso**<br />\nCaso<br />\nSubcaso<br />\nRecurso<br />\nIncidente\n"
          },
          "Title": {
            "type": "string",
            "description": "**Nome Jurídico do caso**"
          },
          "Locale": {
            "type": "string",
            "description": "**Utilizado em casos consultivos**<br />\nFormato: País - Estado - Cidade<br />\nLocal da Jurisdição de um caso, ou cumprimento da obrigação. Utilizado para casos consultivos\n"
          },
          "CourtVenue": {
            "type": "string",
            "description": "**Utilizado para casos contenciosos, judiciais ou não**<br />\nForo do caso, local onde o caso será julgado\n"
          },
          "CaseProcedure": {
            "type": "string",
            "description": "**Rito ou procedimento do caso**"
          },
          "Phase": {
            "type": "string",
            "description": "**Fase do caso**<br />\nEtapas que determinam os procedimentos que devem ser seguidos para a resolução do caso\n"
          },
          "Identities": {
            "description": "**Case identities**",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IdentityEntity"
            }
          },
          "Descendants": {
            "description": "**Case hierarchy**",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaseHierarchy"
            }
          }
        }
