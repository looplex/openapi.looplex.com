                "description": "**Indicação do subtipo de caso, define se ele é um caso originário ou uma continuação como um recurso, incidente ou um subcaso**<br />\nCaso<br />\nSubcaso<br />\nRecurso<br />\nIncidente\n"
              },
              "CaseHierarchy": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/CaseHierarchy"
                    }
                  },
                  {
                    "type": null
                  }
                ]
              },
              "Identities": {
                "description": "**Identificação do caso, como número CNJ, NIRE, Número do contrato, ids de sistemas externos, etc**\n",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/IdentityEntity"
                    }
                  },
                  {
                    "type": null
                  }
                ]
              },
              "Title": {
                "description": "**Nome Jurídico do caso**",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": null
                  }
                ]
              },
              "Summary": {
                "description": "**Breve descrição sobre o caso**",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": null
                  }
                ]
              },
              "Locale": {
                "oneOf": [
                  {
                    "type": "string"
                  },
