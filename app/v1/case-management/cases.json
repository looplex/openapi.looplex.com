                "description": "**Utilizado em casos consultivos**<br />\nFormato: País - Estado - Cidade<br />\nLocal da Jurisdição de um caso, ou cumprimento da obrigação. Utilizado para casos consultivos\n"
              },
              "CourtVenue": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": null
                  }
                ],
                "description": "**Utilizado para casos contenciosos, judiciais ou não**<br />\nForo do caso, local onde o caso será julgado\n"
              },
              "CaseProcedure": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": null
                  }
                ],
                "description": "**Rito ou procedimento do caso**"
              },
              "Phase": {
                "oneOf": [
