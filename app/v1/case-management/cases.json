  "paths": {
    "/Cases/{uniqueId}": {
      "get": {
        "tags": [
          "Case Management"
        ],
        "summary": "Case Retrieve",
        "description": "Retrieve information about a case\n",
        "operationId": "Case-uniqueId-get",
        "parameters": [
          {
            "$ref": "#/components/parameters/OcpApimSubscriptionKey"
          },
          {
            "$ref": "#/components/parameters/Tenant"
          },
          {
            "name": "uniqueId",
            "in": "path",
            "required": true,
            "description": "Case unique guid",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseEntity"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
