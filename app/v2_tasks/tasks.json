          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskEntityWrite"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
